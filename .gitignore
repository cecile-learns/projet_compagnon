# Environnements virtuels
.venv/
.cienv/

# Fichiers techniques Python / Jupyter / système
__pycache__/
*.pyc
.ipynb_checkpoints/
Thumbs.db
.DS_Store
.env

# Fichiers techniques de Windows (téléchargements copiés dans WSL)
*:Zone.Identifier

# Données : jamais dans Git (sources publiques, fichiers volumineux, sur le Drive)
/data/*
*.csv
*.parquet
*.xlsx
*.xls
*.shp
*.shx
*.dbf
*.prj
*.cpg

# Exception : les données de l'application vont dans Git (décision du 17/11).
# Elles sont produites par les scripts de 04_outils et l'application en ligne ne fonctionne pas sans elles.
# Strict nécessaire : seuls les fichiers lus par l'application sont placés dans ce dossier.
!05_application/donnees/*.parquet
!05_application/donnees/*.csv

# Sorties produites par les scripts
02_audit_eda/figures/

# Suivi MLflow (la base du parcours court est dans data/processed/, déjà exclue ; au cas où une base
# serait créée ailleurs, par exemple à la racine)
mlflow.db
mlruns/
mlartifacts/

# Exports et conversions
*.docx
*.pdf
*.html
*_files/
# Installation éditable du socle (pip install -e .)
*.egg-info/
build/
.pytest_cache/

# Clé Groq : jamais dans Git
05_application/.streamlit/secrets.toml